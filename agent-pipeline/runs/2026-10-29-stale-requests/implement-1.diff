diff --git a/backend/src/main/java/com/tanya/workrequests/config/StalenessProperties.java b/backend/src/main/java/com/tanya/workrequests/config/StalenessProperties.java
new file mode 100644
--- /dev/null
+++ b/backend/src/main/java/com/tanya/workrequests/config/StalenessProperties.java
@@ -0,0 +1,22 @@
+package com.tanya.workrequests.config;
+
+import org.springframework.boot.context.properties.ConfigurationProperties;
+import org.springframework.boot.context.properties.bind.DefaultValue;
+
+/**
+ * How old a request may be before it is rejected as stale, bound from {@code app.staleness.*}.
+ * Validated here so a nonsensical threshold fails at startup rather than silently dropping
+ * every request in a batch.
+ */
+@ConfigurationProperties("app.staleness")
+public record StalenessProperties(@DefaultValue("30") int maxAgeDays) {
+
+    public StalenessProperties {
+        if (maxAgeDays < 1) {
+            throw new IllegalArgumentException("app.staleness.max-age-days must be at least 1, was " + maxAgeDays);
+        }
+    }
+}
